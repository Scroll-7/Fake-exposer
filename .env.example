# Groq API key — required for text + vision analysis via LLaMA models
# Get one at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional: multiple Groq keys for automatic failover. When the active key is
# denied (401/403) or rate-limited (429), the app quarantines it and switches to
# the next key. Takes precedence over GROQ_API_KEY when set.
# GROQ_API_KEYS=gsk_key_one,gsk_key_two,gsk_key_three

# Model names — optional. Groq rotates/retires model names per account, so only
# set these if your account exposes different ones (check GET /openai/v1/models).
# GROQ_TEXT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Vision is unavailable on some accounts. Set to empty to skip Groq vision and
# fall back to Gemini + local models: GROQ_VISION_MODELS=
# GROQ_VISION_MODELS=meta-llama/llama-4-scout-17b-16e-instruct,meta-llama/llama-4-maverick-17b-128e-instruct

# Google Gemini API keys — used for AI image forensics
# Comma-separated for automatic failover: a denied (401/403) key is quarantined
# for the day, a rate-limited (429) key is cooled down and retried later.
# Get keys at https://aistudio.google.com/apikey
GEMINI_API_KEYS=your_key_here,your_second_key_here

# Vision models to try in order — optional. Google retires model names, so only
# set this if your account exposes different ones (check GET /v1beta/models).
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-flash-latest

# Optional bearer token guarding the /api endpoints. Leave unset for local dev
# (endpoints stay open; the server logs a warning). When set, every /api request
# must send `Authorization: Bearer <token>` or `X-API-Key: <token>`. Cross-origin
# callers are always rejected unless listed in CORS_ORIGINS below.
# API_AUTH_TOKEN=change-me-to-a-long-random-string

# Set to `production` on a real deployment. In production the server REFUSES to
# start without API_AUTH_TOKEN (an open API can be drained by anyone who can
# reach it). Leave unset for local development.
# NODE_ENV=production

# Cross-origin allowlist — optional. Comma-separated exact origins permitted to
# call /api from a browser. Empty/omitted = same-origin only (recommended).
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

# Trust X-Forwarded-* headers from a reverse proxy / load balancer. Without this,
# rate limiting keys every request to the proxy's IP and one client throttles
# everyone. Prefer `1` (trust one hop) or `loopback`; avoid `true`, which trusts
# every proxy and lets clients spoof X-Forwarded-For. Leave unset when the app
# is directly exposed.
# TRUST_PROXY=1

# Server port (optional, default 3001)
PORT=3001
